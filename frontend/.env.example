# ===========================================
# Value Village Frontend Environment Variables
# ===========================================

# Live Backend API URL
# In local development: http://localhost:5000
# In production on Vercel: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Firebase Web App Credentials (for Google and Apple Sign-In)
# Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=value-village-thrift.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=value-village-thrift
VITE_FIREBASE_STORAGE_BUCKET=value-village-thrift.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
